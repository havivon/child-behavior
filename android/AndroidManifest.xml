<?xml version="1.0" encoding="utf-8"?>
<!--
  "רגוע וחזק" Android wrapper. Built by android/build.sh with aapt (no Gradle).
  versionCode / versionName are the source of truth here; bump both for every
  release you hand out, otherwise Android refuses to install it as an update.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.raguavehazak.app"
    android:versionCode="3"
    android:versionName="1.1.1"
    android:installLocation="internalOnly">

    <uses-sdk android:minSdkVersion="21" android:targetSdkVersion="34" />

    <!-- The only permission: haptic feedback via AndroidBridge.vibrate(). No INTERNET:
         everything, including the Heebo fonts, is embedded in index.html. -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- allowBackup=false: the app promises the data stays on this phone only.
         JSON export (Settings) is the backup path. -->
    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:theme="@style/AppTheme"
        android:supportsRtl="true"
        android:allowBackup="false"
        android:hardwareAccelerated="true">

        <!-- configChanges: rotation, keyboard, dark-mode, font-scale and locale changes are
             handled in-place so the WebView page is never reloaded. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="standard"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="locale|touchscreen|keyboard|keyboardHidden|navigation|orientation|screenLayout|uiMode|screenSize|smallestScreenSize|layoutDirection|fontScale">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
