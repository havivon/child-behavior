<?xml version="1.0" encoding="utf-8"?>
<!-- Light palette, synced with index.html design tokens (:root). Dark overrides live in values-night. -->
<resources>
    <!-- Page background (CSS var bg): window + WebView background, avoids white flashes. -->
    <color name="app_bg">#eef7f6</color>
    <!-- API 21-22 cannot draw dark status-bar icons, so use the brand accent (white icons). -->
    <color name="status_bar">#1a7f76</color>
    <!-- API 21-25 cannot draw dark nav-bar icons, so use a dark bar (CSS var text). -->
    <color name="nav_bar">#12313a</color>
</resources>
